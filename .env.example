# ==============================================================================
# DOCUMIND AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables to match your environment.
# ==============================================================================

# Core Application Settings
DEBUG=True
SECRET_KEY=django-insecure-documind-super-secret-key-change-in-production-!@#$
ALLOWED_HOSTS=localhost,127.0.0.1,web,frontend
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Primary Database (MySQL)
# For local dev without MySQL container running, SQLite fallback is supported if DB_ENGINE=sqlite
DB_ENGINE=mysql
DB_NAME=documind_db
DB_USER=documind_user
DB_PASSWORD=documind_secure_password_2026
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis & Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=documind_collection

# Document Storage (MinIO / S3 Compatible)
STORAGE_BACKEND=local
# Options: 'local' (saves to media/ for standalone local dev) or 's3' (MinIO/AWS S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=documind-documents
MINIO_SECURE=False

# Authentication & JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# LLM Providers & AI Orchestration
# Supported DEFAULT_LLM_PROVIDER: ollama, openai, gemini, anthropic, groq
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# External LLM API Keys (optional if using Ollama locally)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Embedding Model
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# SaaS Quotas and Resource Limits
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENTS_PER_WORKSPACE=100
MAX_WORKSPACES_PER_USER=10
MAX_AGENT_EXECUTION_STEPS=15
MAX_AGENT_EXECUTION_TIMEOUT_SECONDS=120
RATE_LIMIT_REQUESTS_PER_MINUTE=60
